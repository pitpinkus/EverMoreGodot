[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/bag_panel.gd" id="1_bag"]
[ext_resource type="PackedScene" path="res://prefabs/ui/choice_list_panel.tscn" id="2_list"]

[node name="BagPanel" type="VBoxContainer"]
theme_type_variation = &"CompactVBox"
script = ExtResource("1_bag")

[node name="PocketTabs" type="TabBar" parent="."]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"BagPocketTabs"
tab_alignment = 1
clip_tabs = false

[node name="ItemList" parent="." instance=ExtResource("2_list")]
unique_name_in_owner = true
layout_mode = 2
