[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/entry_row_content.gd" id="1_content"]
[ext_resource type="PackedScene" path="res://prefabs/ui/element_badge.tscn" id="2_badge"]

[node name="EntryRowContent" type="HBoxContainer"]
mouse_filter = 2
theme_type_variation = &"CompactHBox"
script = ExtResource("1_content")

[node name="ElementBadge" parent="." instance=ExtResource("2_badge")]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="NameLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_type_variation = &"ListRowNameLabel"
vertical_alignment = 1
text_overrun_behavior = 3

[node name="DetailLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"ListRowDetailLabel"
horizontal_alignment = 2
vertical_alignment = 1
