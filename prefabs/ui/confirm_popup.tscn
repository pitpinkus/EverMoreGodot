[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/confirm_popup.gd" id="1_popup"]
[ext_resource type="PackedScene" path="res://prefabs/ui/dialog_button.tscn" id="2_dialog_button"]

[node name="ConfirmPopup" type="Panel"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"DimmerPanel"
script = ExtResource("1_popup")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(480, 0)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Center/Box"]
layout_mode = 2

[node name="Message" type="Label" parent="Center/Box/Content"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Center/Box/Content"]
layout_mode = 2
alignment = 1

[node name="ConfirmButton" parent="Center/Box/Content/Buttons" instance=ExtResource("2_dialog_button")]
unique_name_in_owner = true
layout_mode = 2
text = "Confirm"

[node name="CancelButton" parent="Center/Box/Content/Buttons" instance=ExtResource("2_dialog_button")]
unique_name_in_owner = true
layout_mode = 2
text = "Cancel"
