[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/levels/level_base.gd" id="1_level"]
[ext_resource type="PackedScene" path="res://prefabs/props/environment_rig.tscn" id="2_environment_rig"]
[ext_resource type="PackedScene" path="res://ui/screens/pause_menu.tscn" id="4_pause_menu"]
[ext_resource type="PackedScene" path="res://ui/screens/inventory_screen.tscn" id="5_inventory"]

[node name="Level" type="Node3D"]
script = ExtResource("1_level")

[node name="EnvironmentRig" parent="." instance=ExtResource("2_environment_rig")]

[node name="Terrain" type="Node3D" parent="."]

[node name="Props" type="Node3D" parent="."]

[node name="Characters" type="Node3D" parent="."]
unique_name_in_owner = true

[node name="SpawnPoints" type="Node3D" parent="."]
unique_name_in_owner = true

[node name="UI" type="CanvasLayer" parent="."]

[node name="PauseMenu" parent="UI" instance=ExtResource("4_pause_menu")]

[node name="InventoryScreen" parent="UI" instance=ExtResource("5_inventory")]
