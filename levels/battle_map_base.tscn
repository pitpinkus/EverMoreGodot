[node name="EnvironmentRig" parent="." instance=ExtResource("2_environment_rig")]

[node name="Terrain" type="Node3D" parent="." groups=["battle_nav_source"]]

[node name="Props" type="Node3D" parent="." groups=["battle_nav_source"]]

[node name="NavRegion" type="NavigationRegion3D" parent="."]
