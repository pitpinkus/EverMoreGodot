[gd_scene format=3]

[ext_resource type="PackedScene" path="res://ui/screens/screen_base.tscn" id="1_base"]
[ext_resource type="Script" path="res://scripts/ui/settings_menu.gd" id="2_menu"]
[ext_resource type="PackedScene" path="res://prefabs/ui/slider_setting_row.tscn" id="3_slider"]
[ext_resource type="PackedScene" path="res://prefabs/ui/toggle_setting_row.tscn" id="4_toggle"]
[ext_resource type="PackedScene" path="res://prefabs/ui/option_setting_row.tscn" id="5_option"]
[ext_resource type="PackedScene" path="res://prefabs/ui/controls_panel.tscn" id="6_controls"]
[ext_resource type="PackedScene" path="res://prefabs/ui/confirm_popup.tscn" id="7_popup"]
[ext_resource type="PackedScene" path="res://prefabs/ui/dialog_button.tscn" id="8_dialog_button"]

[node name="SettingsMenu" instance=ExtResource("1_base")]
script = ExtResource("2_menu")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"ScreenMargin"

[node name="Columns" type="HBoxContainer" parent="Margin"]
layout_mode = 2

[node name="LeftSpacer" type="Control" parent="Margin/Columns"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Content" type="VBoxContainer" parent="Margin/Columns"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 6.0

[node name="TitleLabel" type="Label" parent="Margin/Columns/Content"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Settings"
horizontal_alignment = 1

[node name="Tabs" type="TabContainer" parent="Margin/Columns/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
current_tab = 0

[node name="Audio" type="ScrollContainer" parent="Margin/Columns/Content/Tabs"]
layout_mode = 2
follow_focus = true
horizontal_scroll_mode = 0
metadata/_tab_index = 0

[node name="Rows" type="VBoxContainer" parent="Margin/Columns/Content/Tabs/Audio"]
layout_mode = 2
size_flags_horizontal = 3

[node name="MasterVolume" parent="Margin/Columns/Content/Tabs/Audio/Rows" instance=ExtResource("3_slider")]
layout_mode = 2
setting_key = &"master_volume"
label_text = "Master volume"
display_as_percent = true

[node name="MusicVolume" parent="Margin/Columns/Content/Tabs/Audio/Rows" instance=ExtResource("3_slider")]
layout_mode = 2
setting_key = &"music_volume"
label_text = "Music volume"
display_as_percent = true

[node name="SfxVolume" parent="Margin/Columns/Content/Tabs/Audio/Rows" instance=ExtResource("3_slider")]
layout_mode = 2
setting_key = &"sfx_volume"
label_text = "Sound effects volume"
display_as_percent = true

[node name="UiVolume" parent="Margin/Columns/Content/Tabs/Audio/Rows" instance=ExtResource("3_slider")]
layout_mode = 2
setting_key = &"ui_volume"
label_text = "Interface volume"
display_as_percent = true

[node name="Muted" parent="Margin/Columns/Content/Tabs/Audio/Rows" instance=ExtResource("4_toggle")]
layout_mode = 2
setting_key = &"muted"
label_text = "Mute all audio"

[node name="Display" type="ScrollContainer" parent="Margin/Columns/Content/Tabs"]
layout_mode = 2
follow_focus = true
horizontal_scroll_mode = 0
metadata/_tab_index = 1

[node name="Rows" type="VBoxContainer" parent="Margin/Columns/Content/Tabs/Display"]
layout_mode = 2
size_flags_horizontal = 3

[node name="WindowMode" parent="Margin/Columns/Content/Tabs/Display/Rows" instance=ExtResource("5_option")]
layout_mode = 2
setting_key = &"window_mode"
label_text = "Window mode"
option_labels = PackedStringArray("Windowed", "Borderless", "Fullscreen")

[node name="Resolution" parent="Margin/Columns/Content/Tabs/Display/Rows" instance=ExtResource("5_option")]
layout_mode = 2
setting_key = &"resolution"
label_text = "Resolution"

[node name="MaxFps" parent="Margin/Columns/Content/Tabs/Display/Rows" instance=ExtResource("5_option")]
layout_mode = 2
setting_key = &"max_fps"
label_text = "Frame rate limit"

[node name="Vsync" parent="Margin/Columns/Content/Tabs/Display/Rows" instance=ExtResource("4_toggle")]
layout_mode = 2
setting_key = &"vsync"
label_text = "V-Sync"

[node name="QualityPreset" parent="Margin/Columns/Content/Tabs/Display/Rows" instance=ExtResource("5_option")]
layout_mode = 2
setting_key = &"quality_preset"
label_text = "Graphics quality"

[node name="RenderScale" parent="Margin/Columns/Content/Tabs/Display/Rows" instance=ExtResource("3_slider")]
layout_mode = 2
setting_key = &"render_scale"
label_text = "Render scale"
min_value = 0.5
display_as_percent = true

[node name="Brightness" parent="Margin/Columns/Content/Tabs/Display/Rows" instance=ExtResource("3_slider")]
layout_mode = 2
setting_key = &"brightness"
label_text = "Brightness"
min_value = 0.5
max_value = 1.5

[node name="Gameplay" type="ScrollContainer" parent="Margin/Columns/Content/Tabs"]
layout_mode = 2
follow_focus = true
horizontal_scroll_mode = 0
metadata/_tab_index = 2

[node name="Rows" type="VBoxContainer" parent="Margin/Columns/Content/Tabs/Gameplay"]
layout_mode = 2
size_flags_horizontal = 3

[node name="TextSpeed" parent="Margin/Columns/Content/Tabs/Gameplay/Rows" instance=ExtResource("5_option")]
layout_mode = 2
setting_key = &"text_speed"
label_text = "Text speed"
option_labels = PackedStringArray("Slow", "Normal", "Fast", "Instant")

[node name="CameraSensitivity" parent="Margin/Columns/Content/Tabs/Gameplay/Rows" instance=ExtResource("3_slider")]
layout_mode = 2
setting_key = &"camera_sensitivity"
label_text = "Camera sensitivity"
min_value = 0.1
max_value = 3.0

[node name="InvertCameraY" parent="Margin/Columns/Content/Tabs/Gameplay/Rows" instance=ExtResource("4_toggle")]
layout_mode = 2
setting_key = &"invert_camera_y"
label_text = "Invert camera Y axis"

[node name="BattleAnimations" parent="Margin/Columns/Content/Tabs/Gameplay/Rows" instance=ExtResource("4_toggle")]
layout_mode = 2
setting_key = &"battle_animations"
label_text = "Battle animations"

[node name="Controls" type="ScrollContainer" parent="Margin/Columns/Content/Tabs"]
layout_mode = 2
follow_focus = true
horizontal_scroll_mode = 0
metadata/_tab_index = 3

[node name="ControlsPanel" parent="Margin/Columns/Content/Tabs/Controls" instance=ExtResource("6_controls")]
unique_name_in_owner = true
layout_mode = 2

[node name="TabHint" type="Label" parent="Margin/Columns/Content"]
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "Q / E  or  LB / RB: switch tabs"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Footer" type="HBoxContainer" parent="Margin/Columns/Content"]
layout_mode = 2

[node name="ResetButton" parent="Margin/Columns/Content/Footer" instance=ExtResource("8_dialog_button")]
unique_name_in_owner = true
layout_mode = 2
focus_neighbor_left = NodePath("../ApplyButton")
text = "Reset to defaults"

[node name="FooterSpacer" type="Control" parent="Margin/Columns/Content/Footer"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="BackButton" parent="Margin/Columns/Content/Footer" instance=ExtResource("8_dialog_button")]
unique_name_in_owner = true
layout_mode = 2
text = "Back"

[node name="ApplyButton" parent="Margin/Columns/Content/Footer" instance=ExtResource("8_dialog_button")]
unique_name_in_owner = true
layout_mode = 2
focus_neighbor_right = NodePath("../ResetButton")
text = "Apply"

[node name="RightSpacer" type="Control" parent="Margin/Columns"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="ConfirmPopup" parent="." instance=ExtResource("7_popup")]
unique_name_in_owner = true
layout_mode = 1
