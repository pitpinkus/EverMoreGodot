[gd_scene format=3]

[ext_resource type="PackedScene" path="res://ui/screens/screen_base.tscn" id="1_base"]
[ext_resource type="Script" path="res://scripts/ui/title_screen.gd" id="2_screen"]
[ext_resource type="PackedScene" path="res://prefabs/ui/menu_button.tscn" id="3_button"]
[ext_resource type="PackedScene" path="res://ui/screens/load_menu.tscn" id="4_load"]
[ext_resource type="PackedScene" path="res://ui/screens/settings_menu.tscn" id="5_settings"]
[ext_resource type="PackedScene" path="res://prefabs/components/submenu_switcher.tscn" id="6_switcher"]

[node name="TitleScreen" node_paths=PackedStringArray("initial_focus") instance=ExtResource("1_base")]
script = ExtResource("2_screen")
initial_focus = NodePath("Background/Margin/MenuColumn/StartButton")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"MenuBackground"

[node name="Margin" type="MarginContainer" parent="Background"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"ScreenMargin"

[node name="MenuColumn" type="VBoxContainer" parent="Background/Margin"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4

[node name="TitleLabel" type="Label" parent="Background/Margin/MenuColumn"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Evermore"
horizontal_alignment = 1

[node name="TitleSpacer" type="Control" parent="Background/Margin/MenuColumn"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
mouse_filter = 2

[node name="StartButton" parent="Background/Margin/MenuColumn" instance=ExtResource("3_button")]
unique_name_in_owner = true
layout_mode = 2
focus_neighbor_top = NodePath("../QuitButton")
text = "Start"

[node name="LoadButton" parent="Background/Margin/MenuColumn" instance=ExtResource("3_button")]
unique_name_in_owner = true
layout_mode = 2
text = "Load"

[node name="SettingsButton" parent="Background/Margin/MenuColumn" instance=ExtResource("3_button")]
unique_name_in_owner = true
layout_mode = 2
text = "Settings"

[node name="QuitButton" parent="Background/Margin/MenuColumn" instance=ExtResource("3_button")]
unique_name_in_owner = true
layout_mode = 2
focus_neighbor_bottom = NodePath("../StartButton")
text = "Quit"

[node name="LoadMenu" parent="." instance=ExtResource("4_load")]
unique_name_in_owner = true
visible = false
layout_mode = 1

[node name="SettingsMenu" parent="." instance=ExtResource("5_settings")]
unique_name_in_owner = true
visible = false
layout_mode = 1

[node name="SubmenuSwitcher" parent="." node_paths=PackedStringArray("main_column") instance=ExtResource("6_switcher")]
unique_name_in_owner = true
