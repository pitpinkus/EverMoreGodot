[gd_resource type="Resource" script_class="RebindableActionList" format=3]

[ext_resource type="Script" path="res://scripts/resources/rebindable_action_list.gd" id="1_list"]
[ext_resource type="Script" path="res://scripts/resources/rebindable_action.gd" id="2_action"]

