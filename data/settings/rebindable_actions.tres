[resource]
script = ExtResource("1_list")
actions = Array[ExtResource("2_action")]([SubResource("Resource_move_forward"), SubResource("Resource_move_back"), SubResource("Resource_move_left"), SubResource("Resource_move_right"), SubResource("Resource_run"), SubResource("Resource_jump"), SubResource("Resource_camera_left"), SubResource("Resource_camera_right"), SubResource("Resource_camera_up"), SubResource("Resource_camera_down"), SubResource("Resource_camera_rotate_left"), SubResource("Resource_camera_rotate_right"), SubResource("Resource_camera_zoom_in"), SubResource("Resource_camera_zoom_out"), SubResource("Resource_confirm_point"), SubResource("Resource_cancel_point"), SubResource("Resource_inventory")])
reserved_actions = Array[StringName]([&"pause"])
