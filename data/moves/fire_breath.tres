[gd_resource type="Resource" script_class="MoveData" format=3]

[ext_resource type="Script" path="res://scripts/resources/damage_effect.gd" id="1_damage_effect"]
[ext_resource type="Resource" path="res://data/status_effects/burn.tres" id="2_burn"]
[ext_resource type="Script" path="res://scripts/resources/apply_status_effect.gd" id="3_apply_status_effect"]
[ext_resource type="Script" path="res://scripts/resources/battle_effect.gd" id="4_battle_effect"]
[ext_resource type="Script" path="res://scripts/resources/move_data.gd" id="5_move_data"]
[ext_resource type="Resource" path="res://data/vfx/fire_bolt_vfx.tres" id="6_vfx"]

[sub_resource type="Resource" id="Resource_damage"]
script = ExtResource("1_damage_effect")
power = 60

[sub_resource type="Resource" id="Resource_burn"]
script = ExtResource("3_apply_status_effect")
chance = 100
status = ExtResource("2_burn")
duration = 2

[resource]
script = ExtResource("5_move_data")
id = &"fire_breath"
display_name = "Fire Breath"
description = "Breathes a blast of fire at a close foe. Always burns."
target_kind = 1
max_range = 3.0
effects = Array[ExtResource("4_battle_effect")]([SubResource("Resource_damage"), SubResource("Resource_burn")])
element = 0
accuracy = 85
guaranteed_hit = false
is_direct = true
vfx = ExtResource("6_vfx")
